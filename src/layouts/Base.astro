---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, absoluteUrl, pageKeywords, pageTitle, plain, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywordsExtra?: string[];
  robots?: string;
}

const {
  title,
  description = SITE.description,
  image = '/images/logo.png',
  keywordsExtra = [],
  robots = 'index, follow',
} = Astro.props;

const fullTitle = pageTitle(title);
const desc = plain(description);
const keywords = pageKeywords(title ? [title, ...keywordsExtra] : keywordsExtra);
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = absoluteUrl(withBase(image), origin);
const favicon = (file: string) => withBase(`/${file}`);
---

<!doctype html>
<html lang="en-us" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.title} />
    <link rel="canonical" href={canonical} />
    <meta itemprop="description" content={desc} />
    <meta itemprop="image" content={imageUrl} />
    <meta itemprop="imageUrl" content={imageUrl} />
    <meta itemprop="thumbnailUrl" content={imageUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,650&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={favicon('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon('favicon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon('favicon-64.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={favicon('apple-touch-icon.png')} />
  </head>
  <body>
    <header class="site-header border-b">
      <Header />
    </header>
    <main class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      <slot />
    </main>
    <footer class="bg-zinc-100 py-10 md:py-14">
      <Footer />
    </footer>
    <script>
      const toggleButtons = document.querySelectorAll<HTMLButtonElement>(".toggle-button");

      function hideAllExcept(targetElement: Element) {
        document.querySelectorAll(".open").forEach((element) => {
          if (element !== targetElement) {
            element.classList.add("close");
            element.classList.remove("open");
          }
        });
      }

      function toggleElement(targetElement: Element) {
        const isHidden = targetElement.classList.contains("close");
        hideAllExcept(targetElement);
        targetElement.classList.toggle("close", !isHidden);
        targetElement.classList.toggle("open", isHidden);
      }

      toggleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetIds = (button.getAttribute("data-target") ?? "").split(" ");
          targetIds.forEach((targetId) => {
            const targetElement = document.getElementById(targetId);
            if (targetElement) toggleElement(targetElement);
          });
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        const openElements = Array.from(document.querySelectorAll(".open"));
        const clickedOutside = openElements.every((element) => {
          return !element.contains(target) && !(target instanceof Element && target.closest(".toggle-button"));
        });
        if (!clickedOutside) return;
        openElements.forEach((element) => {
          element.classList.remove("open");
          element.classList.add("close");
        });
      });
    </script>
  </body>
</html>
