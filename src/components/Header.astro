---
import { MENU, SITE, menuState, withBase } from '../lib/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
  <div class="site-bar flex items-center">
    <button
      class="menu-toggle flex items-center rounded-full p-3 bg-zinc-100 hover:bg-zinc-200 toggle-button"
      data-target="menu-bar"
      aria-label="Open menu"
      aria-controls="menu-bar"
    >
      <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
        <path
          fill-rule="evenodd"
          d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"
        ></path>
      </svg>
    </button>
    {isHome ? (
      <h1 class="site-brand">
        <a href={withBase('/')}>
          <img class="rounded-full object-cover" src={withBase('/images/logo.png')} alt="" width="44" height="44" />
          <span class="site-title">{SITE.title}</span>
        </a>
      </h1>
    ) : (
      <div class="site-brand">
        <a href={withBase('/')}>
          <img class="rounded-full object-cover" src={withBase('/images/logo.png')} alt="" width="44" height="44" />
          <span class="site-title">{SITE.title}</span>
        </a>
      </div>
    )}
    <nav id="menu-bar" class="site-nav close">
      <ul class="site-nav-list flex items-center">
        {MENU.map((item) => {
          const state = menuState(item.href, pathname);
          const className = ["site-nav-link", state === "page" ? "is-current" : "", state === "ancestor" ? "ancestor" : ""]
            .filter(Boolean)
            .join(" ");
          return (
            <li class="site-nav-item">
              <a class={className} href={withBase(item.href)} aria-current={state === "page" ? "page" : state === "ancestor" ? "true" : undefined}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="flex items-center ml-auto">
      <button
        class="flex items-center rounded-full p-3 bg-zinc-100 hover:bg-zinc-200 toggle-button"
        data-target="search-bar"
        aria-label="Search"
      >
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
          <path
            id="path1"
            class="transition-all ease-linear"
            d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
  <div id="search-bar" class="block mt-3 close">
    <form id="search" class="flex items-stretch" role="search">
      <input class="w-full block px-6 py-2 rounded-l-full focus:outline-none border border-zinc-200" type="text" placeholder="Search..." aria-label="Search" />
      <button class="flex items-center px-7 py-2.5 rounded-r-full border border-zinc-200" aria-label="Submit search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
          <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"></path>
        </svg>
      </button>
    </form>
  </div>
</div>
