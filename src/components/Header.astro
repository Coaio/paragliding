---
import { MENU, SITE, menuState, withBase } from '../lib/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
  <div class="site-bar flex items-center">
    <button
      class="menu-toggle flex items-center rounded-full p-3 bg-zinc-100 hover:bg-zinc-200 toggle-button"
      data-target="menu-bar"
      aria-label="Open menu"
      aria-controls="menu-bar"
    >
      <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
        <path
          fill-rule="evenodd"
          d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"
        ></path>
      </svg>
    </button>
    {isHome ? (
      <h1 class="site-brand">
        <a href={withBase('/')}>
          <img class="rounded-full object-cover" src={withBase('/images/logo.png')} alt="" width="44" height="44" />
          <span class="site-title">{SITE.title}</span>
        </a>
      </h1>
    ) : (
      <div class="site-brand">
        <a href={withBase('/')}>
          <img class="rounded-full object-cover" src={withBase('/images/logo.png')} alt="" width="44" height="44" />
          <span class="site-title">{SITE.title}</span>
        </a>
      </div>
    )}
    <nav id="menu-bar" class="site-nav close">
      <ul class="site-nav-list flex items-center">
        {MENU.map((item) => {
          const state = menuState(item.href, pathname);
          const className = ["site-nav-link", state === "page" ? "is-current" : "", state === "ancestor" ? "ancestor" : ""]
            .filter(Boolean)
            .join(" ");
          return (
            <li class="site-nav-item">
              <a class={className} href={withBase(item.href)} aria-current={state === "page" ? "page" : state === "ancestor" ? "true" : undefined}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</div>
