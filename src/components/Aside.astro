---
import ListPost from './ListPost.astro';
import { loadApplications } from '../lib/content';

const recent = (await loadApplications()).slice(0, 5);
---

<div class="lg:sticky lg:top-8">
  <div class="space-y-6">
    <h2 class="font-bold text-xl mb-8">Recent Post</h2>
    {recent.map((entry) => <ListPost entry={entry} />)}
  </div>
</div>
