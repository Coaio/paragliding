---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Aside from '../components/Aside.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../lib/site';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing about page');
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description ?? SITE.description}>
  <Breadcrumb items={[{ href: '/', label: SITE.title }]} />
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
    <article class="md:col-span-2 prose lg:prose-lg">
      <header class="not-prose mb-8">
        <h1 class="text-4xl font-bold">{entry.data.title}</h1>
      </header>
      <Content />
    </article>
    <aside class="md:col-span-1">
      <Aside />
    </aside>
  </div>
</Base>
