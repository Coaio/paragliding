---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../lib/site';
---

<Base title={CONTACT.title} description={CONTACT.description}>
  <div class="py-14">
    <h1 class="text-4xl font-bold mb-8">{CONTACT.title}</h1>
    <iframe
      src={CONTACT.form}
      title="Contact form"
      style="width: 100%; height: 720px; border: 0;"
      allowfullscreen>Loading the form…</iframe>
  </div>
</Base>
