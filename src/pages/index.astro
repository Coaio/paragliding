---
import Base from '../layouts/Base.astro';
import HomeGroup from '../components/HomeGroup.astro';
import { groupApplications, loadEntries } from '../lib/content';
import { SECTIONS } from '../lib/site';

const { applications, tutorials } = await loadEntries();
const groups = groupApplications(applications);
---

<Base>
  <section class="home-intro">
    <nav class="home-jump" aria-label="Categories">
      {
        groups.map((group) => (
          <a href={`#${group.id}`}>{group.title}</a>
        ))
      }
      <a href="#tutorials">{SECTIONS.tutorials.title}</a>
    </nav>
  </section>
  {
    groups.map((group) => (
      <HomeGroup
        id={group.id}
        title={group.title}
        description={group.description}
        entries={group.entries}
        noun="tool"
      />
    ))
  }
  <HomeGroup
    id="tutorials"
    title={SECTIONS.tutorials.title}
    description={SECTIONS.tutorials.description}
    entries={tutorials}
    noun="film"
  />
</Base>
