---
import ListLayout from '../../components/ListLayout.astro';
import { paginate } from '../../lib/content';
import { loadApplications } from '../../lib/content';
import { SECTIONS, SITE } from '../../lib/site';

const section = SECTIONS.applications;
const result = paginate(await loadApplications(), 1);
---

<ListLayout
  title={section.title}
  description={section.description}
  entries={result.items}
  page={result.page}
  hasPrev={result.hasPrev}
  hasNext={result.hasNext}
  base="/applications/"
  crumbs={[{ href: '/', label: SITE.title }]}
/>
